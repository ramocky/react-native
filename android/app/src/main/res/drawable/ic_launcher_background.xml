<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标的背景层：与前景同一套深色渐变，保证各家遮罩裁切后色彩一致 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#1C2634"
        android:endColor="#05070A"
        android:type="linear" />
</shape>